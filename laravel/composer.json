{
  "name": "shop/course-platform",
  "description": "Shop API in Laravel with an independent Go inventory service.",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-grpc": "*",
    "ext-pdo_pgsql": "*",
    "firebase/php-jwt": "^7.0",
    "google/protobuf": "^4.0",
    "grpc/grpc": "^1.74",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Inventory\\V1\\": "generated/Inventory/V1/",
      "GPBMetadata\\": "generated/GPBMetadata/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
