{
  "info": {
    "name": "Shop Interview - REST",
    "description": "Run in order with the environment produced by tests/prepare_demo.py. Expected 403 and 404 prove access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Laravel health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Product details and live stock",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/products/{{productId}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Live warehouse quantity matches the prepared scenario\", () => {",
              "    pm.expect(pm.response.json().availableQuantity).to.equal(Number(pm.environment.get(\"expectedStock\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Owner login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.unset(\"ownerToken\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Owner token received\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty);",
              "if (pm.response.code === 200) pm.environment.set(\"ownerToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Owner reads their order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Order ID matches\", () => pm.expect(pm.response.json().id).to.equal(pm.environment.get(\"orderId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Owner cannot change status",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/status",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Confirmed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Visitor login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{visitorEmail}}\",\n  \"password\": \"{{visitorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.unset(\"visitorToken\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Visitor token received\", () => pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty);",
              "if (pm.response.code === 200) pm.environment.set(\"visitorToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Visitor cannot read owner order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/orders/{{orderId}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{visitorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Owner sees order notification",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/notifications",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Notification belongs to the prepared order\", () => {",
              "    pm.expect(pm.response.json().items.some(item => item.orderId === pm.environment.get(\"orderId\"))).to.equal(true);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
